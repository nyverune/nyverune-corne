[Unit]
Description=Nyverune Corne Keyboard Profile Auto-Switch Daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/nyverune/nyverune-corne/scripts/nyverune_switch.py watch
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
